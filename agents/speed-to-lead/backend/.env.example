# Speed to Lead backend: copy to .env and fill in. Never commit .env (it is ignored by git).
# Every value below is read in config.py. Names only, no real secrets in this file.

# ── App ──────────────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=staging                 # staging | production. Production requires a sign-in on every request
LOG_LEVEL=INFO
TEST_FORWARD_NUMBER=                # staging only: every outbound WhatsApp message goes to this number
REQUIRE_AUTH=                       # 1 to force sign-in outside production, 0 to turn it off in production

# ── AI and search ────────────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=                     # Gemini replies and embeddings
PINECONE_API_KEY=

# ── Database and auth (Supabase) ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:6543/postgres
DB_PASSWORD=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=                  # public key, used to check a signed-in user's token
SUPABASE_SERVICE_ROLE_KEY=          # admin key: server side only, never in the browser or in git
SUPABASE_JWT_SECRET=

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────────────────────
# Credentials for a firm or a person's number are stored in the database and used first.
# These are the fallback for a number that has none, and the values for the webhook handshake.
META_ACCESS_TOKEN=                  # system user token with access to the WhatsApp Business account
META_PHONE_NUMBER_ID=               # fallback phone number ID
META_WEBHOOK_VERIFY_TOKEN=          # the token you type into Meta when verifying the webhook
META_APP_SECRET=                    # REQUIRED in production: used to check Meta's request signatures
META_WEBHOOK_URL=                   # this service's public URL ending in /webhook, as registered in Meta
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v20.0

# ── Alerts ───────────────────────────────────────────────────────────────────────────────────
FALLBACK_ALERT_EMAIL=               # who is told when the assistant hands a question to a person
GMAIL_USER=
GMAIL_PASSWORD=                     # a Gmail app password, not the account password

# ── Messages ─────────────────────────────────────────────────────────────────────────────────
BOOKING_LINK=                       # used in no-show recovery messages
MAPS_LINK_INTERIOR=
MAPS_LINK_REAL_ESTATE=

# ── Observability (optional) ─────────────────────────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=speed-to-lead-re-id
